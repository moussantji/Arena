# Déploiement mutualisé (LWS, cPanel…) : le sous-domaine peut pointer
# vers ce dossier. Toutes les requêtes sont alors servies par l'application
# Laravel (api/public). Si votre panneau permet de choisir le dossier
# api/public comme racine du sous-domaine, ce fichier est simplement ignoré.

# En-têtes de sécurité — ignorés proprement si mod_headers est absent
# (l'hébergement mutualisé reste fonctionnel dans tous les cas).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers sensibles jamais servis, même en cas de mauvaise configuration.
    <FilesMatch "(^\.|\.(env|env\..*|lock|json|md|yml|yaml|xml|dist|sh|phar)$)">
        Require all denied
    </FilesMatch>

    RewriteRule ^$ api/public/ [L]
    RewriteRule (.*) api/public/$1 [L]
</IfModule>
